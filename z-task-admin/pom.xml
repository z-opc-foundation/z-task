<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>io.github.yuku123</groupId>
        <artifactId>z-task</artifactId>
        <version>1.0.0</version>
    </parent>

    <artifactId>z-task-admin</artifactId>

    <name>z-task-admin</name>
    <description>任务协作平台可执行管理端应用（ZTaskAdminApplication 主类 + WebMvcConfig +
        启动期 DDL 迁移 runner），repackage 成 fat jar 直接跑，不是给别仓引的库件。
        按组织规范可执行应用归 -admin（对齐 z-camuda：-starter 是无 main 的库件，
        -admin 才带 SpringApplication 主类）⇒ 根 pom 的 central profile 把它排除出 bundle</description>

    <dependencies>
        <!-- 核心模块 -->
        <dependency>
            <groupId>io.github.yuku123</groupId>
            <artifactId>z-task-core</artifactId>
        </dependency>

        <!-- Web模块（包含MyBatis配置, 传递引入 z-ctc-web SSO） -->
        <dependency>
            <groupId>io.github.yuku123</groupId>
            <artifactId>z-task-web</artifactId>
        </dependency>

        <!-- Spring Boot 自动配置 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-autoconfigure</artifactId>
        </dependency>

    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
