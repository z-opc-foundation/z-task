<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>io.github.yuku123</groupId>
        <artifactId>z-task</artifactId>
        <version>1.0.1</version>
    </parent>

    <artifactId>z-task-admin</artifactId>

    <name>z-task :: admin</name>
    <description>任务协作平台可执行管理端应用（ZTaskAdminApplication 主类 + WebMvcConfig +
        启动期 DDL 迁移 runner），repackage 成 fat jar 直接跑，不是给别仓引的库件。
        按组织规范可执行应用归 -admin（对齐 z-camuda：-starter 是无 main 的库件，
        -admin 才带 SpringApplication 主类）⇒ 根 pom 的 central profile 把它排除出 bundle</description>

    <dependencies>
        <!-- 核心模块 -->
        <dependency>
            <groupId>io.github.yuku123</groupId>
            <artifactId>z-task-core</artifactId>
        </dependency>

        <!-- Web模块（包含MyBatis配置, 传递引入 z-ctc-web SSO） -->
        <dependency>
            <groupId>io.github.yuku123</groupId>
            <artifactId>z-task-web</artifactId>
        </dependency>

        <!-- Spring Boot 自动配置 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-autoconfigure</artifactId>
        </dependency>

    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <!-- V2：前端由 _frontend/z-task-suit 经 frontend-maven-plugin 构建，
                 dist/ 再复制进 target/classes/static/（不落 src/main/resources，避免污染源码树）。
                 路由表用绝对路径 /z-task/**（见 component pages-manifest.jsx），后端不加 context-path，
                 前后端同源，由 Ingress / frps 按 Host 分流。 -->
            <plugin>
                <groupId>com.github.eirslett</groupId>
                <artifactId>frontend-maven-plugin</artifactId>
                <version>1.15.0</version>
                <configuration>
                    <workingDirectory>${project.basedir}/../_frontend/z-task-suit</workingDirectory>
                    <installDirectory>${project.basedir}/../_frontend/z-task-suit/.mvn-node</installDirectory>
                </configuration>
                <executions>
                    <execution>
                        <id>install-node-and-npm</id>
                        <goals><goal>install-node-and-npm</goal></goals>
                        <configuration>
                            <nodeVersion>v22.14.0</nodeVersion>
                        </configuration>
                    </execution>
                    <execution>
                        <id>npm-install</id>
                        <goals><goal>npm</goal></goals>
                        <configuration><arguments>install</arguments></configuration>
                    </execution>
                    <execution>
                        <id>npm-build</id>
                        <goals><goal>npm</goal></goals>
                        <configuration><arguments>run build</arguments></configuration>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-resources-plugin</artifactId>
                <executions>
                    <execution>
                        <id>copy-frontend-dist</id>
                        <phase>prepare-package</phase>
                        <goals><goal>copy-resources</goal></goals>
                        <configuration>
                            <outputDirectory>${project.build.outputDirectory}/static</outputDirectory>
                            <resources>
                                <resource>
                                    <directory>${project.basedir}/../_frontend/z-task-suit/dist</directory>
                                    <filtering>false</filtering>
                                </resource>
                            </resources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
