<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>io.github.yuku123</groupId>
        <artifactId>z-task</artifactId>
        <version>1.0.0</version>
    </parent>

    <artifactId>z-task-core</artifactId>

    <!-- name/description 是 Central 的硬要求（发布 pom 上 Project name is missing 会整批判 FAILED），
         url/licenses/developers/scm 由根 pom 经 flatten(oss) 抄进来，这里只补自家这两格。 -->
    <name>z-task-core</name>
    <description>任务协作平台领域层：项目/看板/任务/标签的实体、MyBatis Mapper 与 Service 实现</description>

    <dependencies>
        <!-- Log4j2 API (本模块 src/main/java 含 LogManager.getLogger 调用) -->
        <dependency>
            <groupId>org.apache.logging.log4j</groupId>
            <artifactId>log4j-api</artifactId>
        </dependency>

        <dependency>
            <groupId>io.github.yuku123</groupId>
            <artifactId>z-boot-web-starter</artifactId>
        </dependency>

        <dependency>
            <groupId>io.github.yuku123</groupId>
            <artifactId>z-boot-datasource-starter</artifactId>
        </dependency>

        <dependency>
            <groupId>io.github.yuku123</groupId>
            <artifactId>z-util-core</artifactId>
        </dependency>

        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-lang3</artifactId>
        </dependency>
    </dependencies>

</project>
